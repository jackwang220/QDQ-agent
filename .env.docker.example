# 複製成 .env 用於 Docker 部署。
# 重點：LLM 指到公司內網；langfuse 三個變數「留空」以關閉雲端 tracing（air-gapped 必做）。

# ── 內網 LLM（OpenAI 相容介面）──
API_KEY=dummy-or-internal-key
BASE_URL=http://140.113.228.217:8000/v1
MODEL_NAME=MiniMax-M2.7

# ── Langfuse：留空 = 關閉。三個只要少一個，tracing 就不會啟用，不會連 cloud.langfuse.com ──
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
